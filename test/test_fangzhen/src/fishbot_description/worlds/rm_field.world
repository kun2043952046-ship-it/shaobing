<?xml version="1.0"?>
<sdf version="1.6">
  <world name="rm_world">
    <!-- 太阳光：内联定义，不再用 model://sun，避免 gazebo 去在线模型库拉模型 -->
    <light type="directional" name="sun">
      <cast_shadows>true</cast_shadows>
      <pose>0 0 10 0 0 0</pose>
      <diffuse>0.8 0.8 0.8 1</diffuse>
      <specular>0.2 0.2 0.2 1</specular>
      <attenuation>
        <range>1000</range>
        <constant>0.9</constant>
        <linear>0.01</linear>
        <quadratic>0.001</quadratic>
      </attenuation>
      <direction>-0.5 0.1 -0.9</direction>
    </light>

    <!-- 地面：内联定义，不再用 model://ground_plane
         z 下移到 -0.1（场地底板下表面高度），避免与场地模型的 z=0 地面共面闪烁；
         场地模型的 z=0 地面才是实际行驶面 -->
    <model name="ground_plane">
      <pose>0 0 -0.1 0 0 0</pose>
      <static>true</static>
      <link name="link">
        <collision name="collision">
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>100 100</size>
            </plane>
          </geometry>
        </collision>
        <visual name="visual">
          <cast_shadows>false</cast_shadows>
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>100 100</size>
            </plane>
          </geometry>
          <material>
            <script>
              <uri>file://media/materials/scripts/gazebo.material</uri>
              <name>Gazebo/Grey</name>
            </script>
          </material>
        </visual>
      </link>
    </model>

    <!-- 场地模型：随包携带在 models/rm_field，由 GAZEBO_MODEL_PATH 解析，无需联网 -->
    <include><uri>model://rm_field</uri></include>
  </world>
</sdf>
