<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">
    <xacro:include filename="$(find fishbot_description)/urdf/shaobing/common_inertia.xacro"/>

    <xacro:macro name="laser_xacro" params="xyz">
    <!-- 雷达支撑杆：r=0.02 h=0.23，向下接住底盘顶面(0.22m)，顶端 0.45m -->
     <link name="laser_cylinder_link">
        <!-- 部件外观描述 -->
        <visual>
           <!-- 沿着自己中心的偏移和旋转量 -->
           <origin xyz="0.0 0.0 0.0" rpy="0.0 0.0 0.0"/>
           <!-- 几何形状 -->
           <geometry>
           <!-- 圆柱体 -->
                <cylinder radius="0.02" length="0.23"/>
            
           </geometry>
            <!-- 材质颜色 -->
            <material name="black">
                <color rgba="0.0 0.0 0.0 1.0"/>
            </material>
        </visual>
        <collision>
             <!-- 沿着自己中心的偏移和旋转量 -->
           <origin xyz="0.0 0.0 0.0" rpy="0.0 0.0 0.0"/>
           <!-- 几何形状 -->
           <geometry>
           <!-- 圆柱体 -->
                <cylinder radius="0.02" length="0.23"/>
            
           </geometry>
        </collision>
         <xacro:cylinder_inertia m="0.05" r="0.02" h="0.23"/>  
    </link>
     <!-- 雷达：7cm 边长正方体，中心离地 0.45m -->
     <link name="laser_link">
        <!-- 部件外观描述 -->
        <visual>
           <!-- 沿着自己中心的偏移和旋转量 -->
           <origin xyz="0.0 0.0 0.0" rpy="0.0 0.0 0.0"/>
           <!-- 几何形状 -->
           <geometry>
           <!-- 正方体 -->
               <box size="0.07 0.07 0.07"/>
            
           </geometry>
            <!-- 材质颜色 -->
            <material name="black">
                <color rgba="0.0 0.0 0.0 1.0"/>
            </material>
        </visual> 
        <collision>
           <!-- 沿着自己中心的偏移和旋转量 -->
           <origin xyz="0.0 0.0 0.0" rpy="0.0 0.0 0.0"/>
           <!-- 几何形状 -->
           <geometry>
           <!-- 正方体 -->
               <box size="0.07 0.07 0.07"/>
            
           </geometry>
        </collision>
         <xacro:box_inertia m="0.10" w="0.07" h="0.07" d="0.07"/> 
    </link>

    <!-- 水平连接杆：在 0.45m 高度，从支撑杆顶端(0,0,0.45)水平伸向雷达中心(-0.239,-0.158,0.45)
         长度 = sqrt(0.239^2 + 0.158^2) = 0.2865m，绕 Z 轴指向 -2.5579rad -->
    <link name="laser_connector_link">
        <visual>
           <!-- 沿着自己中心的偏移和旋转量 -->
           <origin xyz="0.0 0.0 0.0" rpy="0.0 0.0 0.0"/>
           <!-- 几何形状 -->
           <geometry>
           <!-- 圆柱体 -->
               <cylinder radius="0.01" length="0.2865"/>
            
           </geometry>
            <!-- 材质颜色 -->
            <material name="black">
                <color rgba="0.0 0.0 0.0 1.0"/>
            </material>
        </visual>
        <collision>
           <!-- 沿着自己中心的偏移和旋转量 -->
           <origin xyz="0.0 0.0 0.0" rpy="0.0 0.0 0.0"/>
           <!-- 几何形状 -->
           <geometry>
           <!-- 圆柱体 -->
               <cylinder radius="0.01" length="0.2865"/>
            
           </geometry>
        </collision>
        <xacro:cylinder_inertia m="0.02" r="0.01" h="0.2865"/>
    </link>

    <!-- 连接杆装在支撑杆中心正上方 0.115m 处（即杆顶 0.45m），先绕 Y 转 90 度放平，再绕 Z 转 -2.5579rad 指向雷达 -->
    <joint name="laser_connector_joint" type="fixed">
        <parent link="laser_cylinder_link"/>
        <child link="laser_connector_link"/>
        <origin xyz="-0.1195 -0.079 0.115" rpy="0.0 1.5708 -2.5579"/>
    </joint>

    <!-- 雷达中心位于 x=-0.239 y=-0.158，高度不变（0.45m） -->
    <joint name="laser_joint" type="fixed">
        <parent link="laser_cylinder_link"/>
        <child link="laser_link"/>
        <origin xyz="-0.239 -0.158 0.115" rpy="0.0 0.0 0.0"/>
    </joint>
     <joint name="laser_cylinderjoint" type="fixed">
        <parent link="base_link"/>
        <child link="laser_cylinder_link"/>
        <origin xyz="${xyz}" rpy="0.0 0.0 0.0"/>
    </joint>
    <gazebo reference='laser_cylinder_link'>
       <material>Gazebo/Black</material>
    </gazebo>
    <gazebo reference='laser_connector_link'>
       <material>Gazebo/Black</material>
    </gazebo>
    <gazebo reference='laser_link'>
        <material>Gazebo/Black</material>
    </gazebo>
</xacro:macro>
</robot>
