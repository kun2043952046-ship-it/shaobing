<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="shaobing">
<!-- 基础 -->
<xacro:include filename="$(find fishbot_description)/urdf/shaobing/base.urdf.xacro"/>
<!-- 传感器 -->
<xacro:include filename="$(find fishbot_description)/urdf/shaobing/sensor/imu.urdf.xacro"/>
<xacro:include filename="$(find fishbot_description)/urdf/shaobing/sensor/camera.urdf.xacro"/>
<xacro:include filename="$(find fishbot_description)/urdf/shaobing/sensor/laser.urdf.xacro"/>
<!-- Mid-360 点云仿真传感器 -->
<xacro:include filename="$(find fishbot_description)/urdf/shaobing/sensor/mid360.xacro"/>
<!-- 执行器 -->
<xacro:include filename="$(find fishbot_description)/urdf/shaobing/actuator/wheel.urdf.xacro"/>
<xacro:include filename="$(find fishbot_description)/urdf/shaobing/actuator/caster.urdf.xacro"/>
<!-- 插件 -->
<xacro:include filename="$(find fishbot_description)/urdf/shaobing/fishbot.ros2_control.xacro"/>

<xacro:base_xacro length="0.10" radius="0.35"/>
<xacro:imu_xacro xyz="0.0 0.0 0.04"/>
<xacro:camera_xacro xyz="0.20 0.0 0.15"/>
<xacro:laser_xacro xyz="0.0 0.0 0.165"/>
<xacro:mid360_xacro horizontal_samples="1440" vertical_samples="40" update_rate="5"/>
<!-- 轮子外侧面与底盘边缘齐平；底盘中心降到 0.17，轮子 z 相应上移 0.07，保持轮心 0.063 贴地 -->
<xacro:wheel_xacro wheel_name="left_wheel" xyz="0.0 0.31 -0.107"/>
<xacro:wheel_xacro wheel_name="right_wheel" xyz="0.0 -0.31 -0.107"/>
<!-- 万向轮：净空未变(0.12)，球半径 0.06 不变、球心仍 0.06，仅 z 上移 0.07 -->
<xacro:caster_xacro caster_name="front_caster" xyz="0.28 0.0 -0.11"/>
<xacro:caster_xacro caster_name="back_caster" xyz="-0.28 0.0 -0.11"/>

<!-- <xacro:gazebo_control_plugin/> -->
<xacro:fishbot_ros2_control/> 
</robot>
